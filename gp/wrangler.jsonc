{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "globproxy5",
  // Not bumped deliberately: newer compatibility dates change runtime
  // behaviour (Node HTTP modules, etc.) and this repo has no workerd-based
  // test to prove the app is unaffected. Move it forward together with a
  // preview deploy, not as a drive-by edit.
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Persist Worker logs. Without this, every console.error in the payment,
  // webhook and cron paths is gone the moment the request ends.
  "observability": { "enabled": true },
  // Upload source maps so stack traces in the persisted logs name real files and lines.
  "upload_source_maps": true,
  // Exposes the id of the deployed version to the Worker as env.CF_VERSION_METADATA.id.
  // custom-worker.ts puts it in the anonymous edge-cache key, so a deploy can never
  // be followed by cached HTML that points at JS files the new build no longer has;
  // /api/health reports it too.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // `wrangler deploy` replaces the Worker's plain-text dashboard variables with
  // whatever this file declares (nothing), silently wiping any that were added by
  // hand. Keep them. (Secrets were never affected; deploy.yml pushes those.)
  "keep_vars": true,
  "main": "custom-worker.ts",
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Left at Cloudflare's defaults on purpose: this file does not know whether
  // anything still uses the *.workers.dev address (previews, staging). While
  // it stays reachable, next.config.ts marks every *.workers.dev response
  // noindex so it can't compete with the real domain in search. Once nothing
  // depends on it, add `"workers_dev": false, "preview_urls": false` here.
  // Native Cloudflare Cron Triggers — see custom-worker.ts for the full
  // rationale. Keep in sync with custom-worker.ts's CRON_TASKS map.
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 * * * *",
      "0 8 * * *",
      "0 */6 * * *",
      "5 8 * * *"
    ]
  },
  // Cloudflare's native rate-limiting bindings — auto-provisioned on deploy,
  // no separate `wrangler kv namespace create`-style step needed. See
  // lib/rateLimit.ts for what each one protects. namespace_id just needs to
  // be unique among rate-limit bindings in this account; the numbers have no
  // significance beyond that. `period` must be 10 or 60 (Cloudflare limit).
  // The edge-pipeline bindings below use the 11xx block on purpose: other work
  // keeps adding bindings at the next free low number, and a duplicated id would
  // silently make two limiters share one counter.
  "unsafe": {
    "bindings": [
      // Unauthenticated / credential-handling auth endpoints, per client
      // address per route group. 20/min rather than a tighter figure because
      // mobile carriers put many subscribers behind one shared IPv4 address.
      {
        "name": "AUTH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      },
      // Public v1 API, per API key (lib/apiAuth.ts). 120 requests / minute
      // overall, and a tighter 30 / minute for mutating calls (create /
      // delete / top-up provision real upstream resources). Documented in
      // /docs/api — change both places together.
      {
        "name": "API_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 120, "period": 60 }
      },
      {
        "name": "API_WRITE_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 30, "period": 60 }
      },
      // GET /api/v1/sub-users/:id/usage/history — each call fans out up to 30
      // requests on the one shared reseller key at the provider (same reason
      // the dashboard's usage/history route is limited), so it gets a much
      // tighter per-key budget than the general limiter.
      {
        "name": "API_HISTORY_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1004",
        "simple": { "limit": 10, "period": 60 }
      },
      // Reseller allocate / reclaim, applied per address+reseller AND per
      // reseller via rateLimitedUser (see app/api/reseller/allocate/route.ts). Higher than AUTH so a legitimate
      // bulk allocation isn't throttled, but low enough to stop the allocate
      // endpoint being used as an email cannon or a registered-email oracle.
      {
        "name": "RESELLER_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1005",
        "simple": { "limit": 30, "period": 60 }
      },
      // Payments: /api/checkout (per user and per address+user) and the unauthenticated
      // /api/verify-payment (keyed per IP). Every verify call that reaches a
      // real reference spends one request against Paystack's own API quota,
      // which the reconcile cron and genuine customers share — so the public
      // endpoint is capped. Generous enough for the client's confirm-polling
      // (<= 8 calls over ~25s) several times over.
      {
        "name": "PAYMENT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1006",
        "simple": { "limit": 30, "period": 60 }
      },
      // Per target email across all callers: signup / password reset /
      // resend-confirmation. Bounds how many emails anyone can make us send
      // to one inbox, however many addresses the requests come from.
      {
        "name": "AUTH_TARGET_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1101",
        "simple": { "limit": 5, "period": 60 }
      },
      // v1 API, per client address, checked BEFORE the key lookup. Deliberately
      // very high: resellers often share one egress address across many keys
      // (each allowed 120/min), and this must never throttle them. 6000/min is
      // 100 requests/second from a single address — it only exists to cap how
      // many database lookups invalid-key traffic can trigger.
      {
        "name": "API_IP_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1102",
        "simple": { "limit": 6000, "period": 60 }
      },
      // Per signed-in user: session-authenticated routes that spend money,
      // create upstream resources, or make our server call out.
      {
        "name": "USER_ACTION_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1103",
        "simple": { "limit": 30, "period": 60 }
      },
      // Per signed-in user: routes that email staff on every call.
      {
        "name": "USER_EMAIL_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1104",
        "simple": { "limit": 3, "period": 60 }
      }
    ]
  }
}
