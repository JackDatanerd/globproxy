{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "globproxy5",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Persist Worker logs. Without this, every console.error in the payment,
  // webhook and cron paths is gone the moment the request ends.
  "observability": { "enabled": true },
  "main": "custom-worker.ts",
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Native Cloudflare Cron Triggers — see custom-worker.ts for the full
  // rationale (replaces cron-job.org, already disabled, and the three
  // GitHub Actions cron-*.yml workflows, to be deleted once this is
  // verified live). Keep in sync with custom-worker.ts's CRON_TASKS map.
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 * * * *",
      "0 8 * * *",
      "0 */6 * * *",
      "5 8 * * *"
    ]
  },
  // Cloudflare's native rate-limiting binding — auto-provisioned on deploy,
  // no separate `wrangler kv namespace create`-style step needed. Shared by
  // auth/signup and auth/reset (see lib/rateLimit.ts). namespace_id just
  // needs to be unique among rate-limit bindings in this account; 1001 has
  // no significance beyond that.
  "unsafe": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      // Public v1 API, per API key (lib/apiAuth.ts). 120 requests / minute
      // overall, and a tighter 30 / minute for mutating calls (create /
      // delete / top-up provision real upstream resources). Documented in
      // /docs/api — change both places together.
      {
        "name": "API_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 120, "period": 60 }
      },
      {
        "name": "API_WRITE_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 30, "period": 60 }
      },
      // GET /api/v1/sub-users/:id/usage/history — each call fans out up to 30
      // requests on the one shared reseller key at the provider (same reason
      // the dashboard's usage/history route is limited), so it gets a much
      // tighter per-key budget than the general limiter.
      {
        "name": "API_HISTORY_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1004",
        "simple": { "limit": 10, "period": 60 }
      },
      // Reseller allocate / reclaim, keyed per reseller (see
      // app/api/reseller/allocate/route.ts). Higher than AUTH so a legitimate
      // bulk allocation isn't throttled, but low enough to stop the allocate
      // endpoint being used as an email cannon or a registered-email oracle.
      {
        "name": "RESELLER_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1005",
        "simple": { "limit": 30, "period": 60 }
      },
      // Payments: /api/checkout (keyed per user) and the unauthenticated
      // /api/verify-payment (keyed per IP). Every verify call that reaches a
      // real reference spends one request against Paystack's own API quota,
      // which the reconcile cron and genuine customers share — so the public
      // endpoint is capped. Generous enough for the client's confirm-polling
      // (<= 8 calls over ~25s) several times over.
      {
        "name": "PAYMENT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1006",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  }
}
