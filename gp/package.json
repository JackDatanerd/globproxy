{
  "name": "globproxy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cf": "node scripts/check-cron-sync.mjs && node scripts/check-api-docs-sync.mjs && node scripts/check-supplier-leak.mjs && opennextjs-cloudflare build",
    "check:cron": "node scripts/check-cron-sync.mjs",
    "check:api-docs": "node scripts/check-api-docs-sync.mjs",
    "check:supplier": "node scripts/check-supplier-leak.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "check:fast": "npm run check:schema && npm run check:cron && npm run check:api-docs && npm run check:supplier && npm test",
    "check": "npm run check:fast && npm run typecheck",
    "check:migrations": "node scripts/check-migrations-applied.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "deploy:manual-DANGER": "opennextjs-cloudflare build && npx wrangler deploy",
    "check:schema": "node scripts/check-schema-sync.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "fold:migration": "node scripts/fold-migration.mjs",
    "pull:targeting": "node scripts/pull-targeting.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.26.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.4",
    "clsx": "^2.1.1",
    "next": "16.4.2",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^22",
    "@types/paystack__inline-js": "^1.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
